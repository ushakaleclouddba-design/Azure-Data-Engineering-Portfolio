					"computeProperties": {
						"location": "West US 2",
						"nodeSize": "Standard_D2_v3",
						"numberOfNodes": 1,
						"maxParallelExecutionsPerNode": 1,
						"vNetProperties": {
							"subnetId": "/subscriptions/26f7a991-84b3-47b7-966b-f19cbb0379bf/resourceGroups/Usha_SQLMI_POC/providers/Microsoft.Network/virtualNetworks/vnet-usha-sqlmi-poc/subnets/AzureSSIS-Subnet"
