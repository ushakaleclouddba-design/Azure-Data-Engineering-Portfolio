{
	"name": "PL_Child_Copy_SQL_Incremental",
	"properties": {
		"description": "CCopies only changed rows of one on-prem SQL Server table (Rowversion / Change Tracking / CDC) to bronze Parquet; moves the watermark only on success.",
		"activities": [
			{
				"name": "LK_GetChangeWindow",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderStoredProcedureName": "[etl].[usp_GetChangeWindow]",
						"storedProcedureParameters": {
							"LastWatermark": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.LastWatermark",
									"type": "Expression"
								}
							},
							"LoadType": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.LoadType",
									"type": "Expression"
								}
							},
							"SchemaName": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.SchemaName",
									"type": "Expression"
								}
							},
							"TableName": {
								"type": "String",
								"value": {
									"value": "@pipeline().parameters.TableName",
									"type": "Expression"
								}
							}
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQLSRV_OnPrem_Table",
						"type": "DatasetReference",
						"parameters": {
							"ServerName": {
								"value": "@pipeline().parameters.ServerName",
								"type": "Expression"
							},
							"DatabaseName": {
								"value": "@pipeline().parameters.DatabaseName",
								"type": "Expression"
							},
							"TableName": {
								"value": "@pipeline().parameters.SchemaName",
								"type": "Expression"
							},
							"SchemaName": {
								"value": "@pipeline().parameters.TableName",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "SV_BuildQuery",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "LK_GetChangeWindow",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "QueryText",
					"value": {
						"value": "@if(activity('LK_GetChangeWindow').output.firstRow.IsFullLoad,\n  concat('SELECT ''I'' AS ChangeOp, t.* FROM ', pipeline().parameters.SchemaName, '.', pipeline().parameters.TableName, ' t'),\n  if(equals(pipeline().parameters.LoadType, 'Rowversion'),\n    concat('SELECT ''U'' AS ChangeOp, t.* FROM ', pipeline().parameters.SchemaName, '.', pipeline().parameters.TableName,\n           ' t WHERE t.', pipeline().parameters.WatermarkColumn, ' >= ', activity('LK_GetChangeWindow').output.firstRow.FromValue,\n           ' AND t.', pipeline().parameters.WatermarkColumn, ' < ', activity('LK_GetChangeWindow').output.firstRow.ToValue),\n    if(equals(pipeline().parameters.LoadType, 'ChangeTracking'),\n      concat('SELECT ct.SYS_CHANGE_OPERATION AS ChangeOp, ct.SYS_CHANGE_VERSION AS ChangeVersion, ct.', pipeline().parameters.KeyColumns,\n             ' AS ChangeKey, t.* FROM CHANGETABLE(CHANGES ', pipeline().parameters.SchemaName, '.', pipeline().parameters.TableName, ', ',\n             activity('LK_GetChangeWindow').output.firstRow.FromValue, ') ct LEFT JOIN ', pipeline().parameters.SchemaName, '.',\n             pipeline().parameters.TableName, ' t ON t.', pipeline().parameters.KeyColumns, ' = ct.', pipeline().parameters.KeyColumns,\n             ' WHERE ct.SYS_CHANGE_VERSION <= ', activity('LK_GetChangeWindow').output.firstRow.ToValue),\n      concat('SELECT CASE c.[__$operation] WHEN 1 THEN ''D'' WHEN 2 THEN ''I'' ELSE ''U'' END AS ChangeOp, ',\n             'CONVERT(VARCHAR(30), c.[__$start_lsn], 1) AS ChangeLSN, c.* FROM cdc.fn_cdc_get_all_changes_',\n             pipeline().parameters.SchemaName, '_', pipeline().parameters.TableName, '(',\n             activity('LK_GetChangeWindow').output.firstRow.FromValue, ', ',\n             activity('LK_GetChangeWindow').output.firstRow.ToValue, ', ''all'') c'))))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "IF_HasChanges",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "SV_BuildQuery",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('LK_GetChangeWindow').output.firstRow.HasChanges",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "SP_Log_NoChanges",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[etl].[usp_LogCopyResult]",
								"storedProcedureParameters": {
									"RunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineName": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"TableID": {
										"value": {
											"value": "@pipeline().parameters.TableID",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"StartTime": {
										"value": {
											"value": "@pipeline().TriggerTime",
											"type": "Expression"
										},
										"type": "Datetime"
									},
									"Status": {
										"value": "Succeeded",
										"type": "String"
									},
									"RowsRead": {
										"value": "0",
										"type": "Int64"
									},
									"RowsCopied": {
										"value": "0",
										"type": "Int64"
									},
									"DataReadBytes": {
										"value": "0",
										"type": "Int64"
									},
									"CopyDurationSec": {
										"value": "0",
										"type": "Int32"
									},
									"TargetPath": {
										"value": null,
										"type": "String"
									},
									"ErrorMessage": {
										"value": null,
										"type": "String"
									},
									"WatermarkFrom": {
										"value": "@activity('LK_GetChangeWindow').output.firstRow.FromValue",
										"type": "String"
									},
									"WatermarkTo": {
										"value": "@activity('LK_GetChangeWindow').output.firstRow.ToValue",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AZSQL_DW",
								"type": "LinkedServiceReference",
								"parameters": {
									"Servername": "usha-poc-sqlsvr.database.windows.net",
									"DatabaseName": "AssetMgmt_DW"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "CP_SQL_To_Bronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": "@variables('QueryText')",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_SQLSRV_OnPrem_Table",
									"type": "DatasetReference",
									"parameters": {
										"ServerName": {
											"value": "@pipeline().parameters.ServerName",
											"type": "Expression"
										},
										"DatabaseName": {
											"value": "@pipeline().parameters.DatabaseName",
											"type": "Expression"
										},
										"TableName": {
											"value": "@pipeline().parameters.TableName",
											"type": "Expression"
										},
										"SchemaName": {
											"value": "@pipeline().parameters.SchemaName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Bronze_Parquet",
									"type": "DatasetReference",
									"parameters": {
										"Container": {
											"value": "@pipeline().parameters.Container",
											"type": "Expression"
										},
										"FolderPath": {
											"value": "@concat(pipeline().parameters.TargetFolder, '/load_date=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'))",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat(pipeline().parameters.TableName, '_', formatDateTime(pipeline().TriggerTime, 'HHmmss'), '_', substring(pipeline().RunId, 0, 8), '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "SP_Log_Success",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "CP_SQL_To_Bronze",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[etl].[usp_LogCopyResult]",
								"storedProcedureParameters": {
									"RunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineName": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"TableID": {
										"value": {
											"value": "@pipeline().parameters.TableID",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"StartTime": {
										"value": {
											"value": "@pipeline().TriggerTime",
											"type": "Expression"
										},
										"type": "Datetime"
									},
									"Status": {
										"value": "Succeeded",
										"type": "String"
									},
									"RowsRead": {
										"value": {
											"value": "@activity('CP_SQL_To_Bronze').output.rowsRead",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"RowsCopied": {
										"value": {
											"value": "@activity('CP_SQL_To_Bronze').output.rowsCopied",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"DataReadBytes": {
										"value": {
											"value": "@activity('CP_SQL_To_Bronze').output.dataRead",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"CopyDurationSec": {
										"value": {
											"value": "@activity('CP_SQL_To_Bronze').output.copyDuration",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"TargetPath": {
										"value": {
											"value": "@concat(pipeline().parameters.Container, '/', pipeline().parameters.TargetFolder, '/load_date=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), '/', pipeline().parameters.TableName, '_', formatDateTime(pipeline().TriggerTime, 'HHmmss'), '_', substring(pipeline().RunId, 0, 8), '.parquet')",
											"type": "Expression"
										},
										"type": "String"
									},
									"ErrorMessage": {
										"value": null,
										"type": "String"
									},
									"WatermarkFrom": {
										"value": "@activity('LK_GetChangeWindow').output.firstRow.FromValue",
										"type": "String"
									},
									"WatermarkTo": {
										"value": "@activity('LK_GetChangeWindow').output.firstRow.ToValue",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AZSQL_DW",
								"type": "LinkedServiceReference",
								"parameters": {
									"Servername": "usha-poc-sqlsvr.database.windows.net",
									"DatabaseName": "AssetMgmt_DW"
								}
							}
						},
						{
							"name": "SP_Log_Failure",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "CP_SQL_To_Bronze",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[etl].[usp_LogCopyResult]",
								"storedProcedureParameters": {
									"RunId": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"PipelineName": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"TableID": {
										"value": {
											"value": "@pipeline().parameters.TableID",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"StartTime": {
										"value": {
											"value": "@pipeline().TriggerTime",
											"type": "Expression"
										},
										"type": "Datetime"
									},
									"Status": {
										"value": "Failed",
										"type": "String"
									},
									"RowsRead": {
										"value": null,
										"type": "Int64"
									},
									"RowsCopied": {
										"value": null,
										"type": "Int64"
									},
									"DataReadBytes": {
										"value": null,
										"type": "Int64"
									},
									"CopyDurationSec": {
										"value": null,
										"type": "Int32"
									},
									"TargetPath": {
										"value": {
											"value": "@concat(pipeline().parameters.Container, '/', pipeline().parameters.TargetFolder, '/load_date=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), '/', pipeline().parameters.TableName, '_', formatDateTime(pipeline().TriggerTime, 'HHmmss'), '_', substring(pipeline().RunId, 0, 8), '.parquet')",
											"type": "Expression"
										},
										"type": "String"
									},
									"ErrorMessage": {
										"value": {
											"value": "@substring(activity('CP_SQL_To_Bronze').error.message, 0, min(length(activity('CP_SQL_To_Bronze').error.message), 3900))",
											"type": "Expression"
										},
										"type": "String"
									},
									"WatermarkFrom": {
										"value": "@activity('LK_GetChangeWindow').output.firstRow.FromValue",
										"type": "String"
									},
									"WatermarkTo": {
										"value": "@activity('LK_GetChangeWindow').output.firstRow.ToValue",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AZSQL_DW",
								"type": "LinkedServiceReference",
								"parameters": {
									"Servername": "usha-poc-sqlsvr.database.windows.net",
									"DatabaseName": "AssetMgmt_DW"
								}
							}
						},
						{
							"name": "FAIL_COPY",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "SP_Log_Failure",
									"dependencyConditions": [
										"Completed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Copy failed for ', pipeline().parameters.DatabaseName, '.', pipeline().parameters.SchemaName, '.', pipeline().parameters.TableName, ': ', activity('CP_SQL_To_Bronze').error.message)",
									"type": "Expression"
								},
								"errorCode": " BAYVIEW_COPY_FAILED"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"TableID": {
				"type": "int",
				"defaultValue": 4
			},
			"ServerName": {
				"type": "string",
				"defaultValue": "NODE5"
			},
			"DatabaseName": {
				"type": "string",
				"defaultValue": "AssetMgmt_source"
			},
			"SchemaName": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"TableName": {
				"type": "string",
				"defaultValue": "Position"
			},
			"Container": {
				"type": "string",
				"defaultValue": "landing"
			},
			"TargetFolder": {
				"type": "string",
				"defaultValue": "AssetMgmt_source/dbo/Position"
			},
			"LoadType": {
				"type": "string",
				"defaultValue": "Rowversion"
			},
			"KeyColumns": {
				"type": "string",
				"defaultValue": "PositionID"
			},
			"WatermarkColumn": {
				"type": "string",
				"defaultValue": "RowVer"
			},
			"LastWatermark": {
				"type": "string",
				"defaultValue": " "
			}
		},
		"variables": {
			"QueryText": {
				"type": "String"
			}
		},
		"annotations": []
	}
}