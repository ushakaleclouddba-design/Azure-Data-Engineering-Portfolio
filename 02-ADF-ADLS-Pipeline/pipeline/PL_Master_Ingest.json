{
	"name": "PL_Master_Ingest",
	"properties": {
		"activities": [
			{
				"name": "LK_Get_ControlRows",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "    SELECT TableID, SourceType, SourceServer, SourceDatabase, SourceSchema, SourceTable,\n          LoadType, KeyColumns, WatermarkColumn,LastWatermark,\n          TargetContainer, TargetFolder\n   FROM etl.ControlTable\n   WHERE IsActive = 1\n   ORDER BY Priority, TableID;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AZSQL_DW_Table",
						"type": "DatasetReference",
						"parameters": {
							"ServerName": "usha-poc-sqlsvr.database.windows.net",
							"DatabaseName": "AssetMgmt_DW",
							"SchemaName": "etl",
							"TableName": "ControlTable"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FE_Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LK_Get_ControlRows",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LK_Get_ControlRows').output.value",
						"type": "Expression"
					},
					"batchCount": 4,
					"activities": [
						{
							"name": "SW_SourceType",
							"type": "Switch",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"on": {
									"value": "@concat(item().SourceType, '_', if(equals(item().LoadType, 'Full'), 'Full', 'Incremental'))",
									"type": "Expression"
								},
								"cases": [
									{
										"value": "SqlServer_Full",
										"activities": [
											{
												"name": "EP_Child_Copy_SQL",
												"type": "ExecutePipeline",
												"dependsOn": [],
												"policy": {
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"pipeline": {
														"referenceName": "PL_Child_Copy_SQL_Full",
														"type": "PipelineReference"
													},
													"waitOnCompletion": true,
													"parameters": {
														"TableID": {
															"value": "@item().TableID",
															"type": "Expression"
														},
														"ServerName": {
															"value": "@item().SourceServer",
															"type": "Expression"
														},
														"DatabaseName": {
															"value": "@item().SourceDatabase",
															"type": "Expression"
														},
														"SchemaName": {
															"value": "@item().SourceSchema",
															"type": "Expression"
														},
														"TableName": {
															"value": "@item().SourceTable",
															"type": "Expression"
														},
														"Container": {
															"value": "@item().TargetContainer",
															"type": "Expression"
														},
														"TargetFolder": {
															"value": "@item().TargetFolder",
															"type": "Expression"
														}
													}
												}
											}
										]
									},
									{
										"value": "Oracle_Full",
										"activities": [
											{
												"name": "EP_Child_Copy_ORCL",
												"type": "ExecutePipeline",
												"dependsOn": [],
												"policy": {
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"pipeline": {
														"referenceName": "PL_Child_Copy_ORCL_Full",
														"type": "PipelineReference"
													},
													"waitOnCompletion": true,
													"parameters": {
														"TableID": {
															"value": "@item().TableID",
															"type": "Expression"
														},
														"ServerName": {
															"value": "@item().SourceServer",
															"type": "Expression"
														},
														"DatabaseName": {
															"value": "@item().SourceDatabase",
															"type": "Expression"
														},
														"SchemaName": {
															"value": "@item().SourceSchema",
															"type": "Expression"
														},
														"TableName": {
															"value": "@item().SourceTable",
															"type": "Expression"
														},
														"Container": {
															"value": "@item().TargetContainer",
															"type": "Expression"
														},
														"TargetFolder": {
															"value": "@item().TargetFolder",
															"type": "Expression"
														}
													}
												}
											}
										]
									},
									{
										"value": "SqlServer_Incremental",
										"activities": [
											{
												"name": "EP_Child_Copy_SQL_Incr",
												"type": "ExecutePipeline",
												"dependsOn": [],
												"policy": {
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"pipeline": {
														"referenceName": "PL_Child_Copy_SQL_Incremental",
														"type": "PipelineReference"
													},
													"waitOnCompletion": true,
													"parameters": {
														"TableID": "@item().TableID",
														"ServerName": "@item().SourceServer",
														"DatabaseName": "@item().SourceDatabase",
														"SchemaName": "@item().SourceSchema",
														"TableName": "@item().SourceTable",
														"Container": "@item().TargetContainer",
														"TargetFolder": "@item().TargetFolder",
														"LoadType": "@item().LoadType",
														"KeyColumns": "@coalesce(item().KeyColumns, '')",
														"WatermarkColumn": "@coalesce(item().WatermarkColumn, '')",
														"LastWatermark": "@coalesce(item().LastWatermark, '')"
													}
												}
											}
										]
									}
								],
								"defaultActivities": [
									{
										"name": "FAIL_UnknownSourceType",
										"type": "Fail",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"message": {
												"value": "@concat('Unsupported SourceType: ', item().SourceType, ' (TableID ', string(item().TableID), ')')",
												"type": "Expression"
											},
											"errorCode": "BAYVIEW_UNKNOWN_SOURCETYPE"
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}