{
	"name": "LS_SQLSRV_OnPrem",
	"properties": {
		"description": "Any on-prem SQL Server via SHIR; server and database passed as parameters; password from Key Vault",
		"parameters": {
			"Servername": {
				"type": "string",
				"defaultValue": "Node5"
			},
			"DatabaseName": {
				"type": "string",
				"defaultValue": "AssetMgmt_source"
			}
		},
		"annotations": [],
		"type": "SqlServer",
		"typeProperties": {
			"server": "@{linkedService().Servername}",
			"database": "@{linkedService().DatabaseName}",
			"encrypt": "mandatory",
			"trustServerCertificate": true,
			"authenticationType": "SQL",
			"userName": "adfuser",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "LS_KV_Bayview",
					"type": "LinkedServiceReference"
				},
				"secretName": "adfuserPassword"
			}
		},
		"connectVia": {
			"referenceName": "SHIR-Node5",
			"type": "IntegrationRuntimeReference"
		}
	}
}